{
  "name": "it-cost-mobile",
  "main": "expo-router/entry",
  "version": "1.1.0",
  "scripts": {
    "preflight": "npm run cleanup:stale-tabs && npm run gen:tabs && npm run check:router && npm run check:duplicates && npm run check:functionality",
    "start": "expo start",
    "dev": "expo start",
    "fresh": "expo start -c",
    "start:fresh": "expo start -c",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "expo:prebuild": "npm run preflight && expo prebuild",
    "prebuild:android": "npm run preflight && expo prebuild -p android",
    "prebuild:ios": "npm run preflight && expo prebuild -p ios",
    "lint": "expo lint",
    "gen:tabs": "node scripts/generate-tabs.mjs",
    "cleanup:stale-tabs": "node scripts/cleanup-stale-tabs.mjs",
    "check:router": "node scripts/check-router.mjs",
    "check": "npm run preflight && npm run test:logic",
    "build:test-logic": "node -e \"require('fs').rmSync('.logic-test-dist',{recursive:true,force:true})\" && tsc -p tsconfig.logic-tests.json",
    "test:logic": "npm run build:test-logic && node --test tests/logic/*.test.cjs",
    "prestart": "npm run preflight",
    "predev": "npm run preflight",
    "prefresh": "npm run preflight",
    "prestart:fresh": "npm run preflight",
    "preandroid": "npm run preflight",
    "preios": "npm run preflight",
    "preweb": "npm run preflight",
    "prebuild": "npm run preflight",
    "check:duplicates": "node scripts/check-duplicates.mjs",
    "check:functionality": "node scripts/check-functionality.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-picker/picker": "^2.11.4",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.15.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
